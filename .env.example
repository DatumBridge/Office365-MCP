# Office 365 MCP Configuration

PORT=8000
LOG_LEVEL=INFO

# Azure AD app (delegated permissions)
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
# common | organizations | {tenant-id}
OFFICE365_TENANT_ID=common
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Optional path to credentials.json with client_id/client_secret
# OFFICE365_OAUTH_CREDENTIALS=/app/credentials.json

# HTTP timeout (seconds). Default 60.
# OFFICE365_HTTP_TIMEOUT_SEC=60

# Path jail for credentials_path (defaults to project root)
# OFFICE365_CREDENTIALS_DIR=/var/office365-credentials

# Local OAuth/test UI. Set 1 for /test and OAuth connect.
OFFICE365_ENABLE_OAUTH_UI=0

# Optional Tool Registry (platform)
# TOOL_REGISTRY_BASE_URL=http://datumbridge-mcp:8081/api/v1
# TOOL_REGISTRY_API_KEY=
